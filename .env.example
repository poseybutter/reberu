# .env로 복사 후 값 입력 (.env는 Git 업로드 금지)

# 필수: 로컬 PostgreSQL 비밀번호 (compose.yml과 애플리케이션 공용)
DB_PASSWORD=

# 필수: 목록 커서 서명 키 (base64, 32바이트 이상. 만들기: openssl rand -base64 32)
CURSOR_SIGNING_KEY=

# 필수: Google OAuth 클라이언트 (Google Cloud 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택: 비우면 application.yml 기본값 사용
# APP_BASE_URL=
# TERMS_VERSION=
# PRIVACY_VERSION=
# DB_URL=
# DB_USERNAME=
# APP_VERSION=
# APP_MIN_VERSION=
# SESSION_IDLE_TIMEOUT=8h
# SESSION_MAX_LIFETIME=7d
# SESSION_MAX_PER_ACCOUNT=10
# 활동 기록 보관 기간 (365d 미만이면 시작 실패)
# ACTIVITY_LOG_RETENTION=365d
# 배포 모드 MULTI_ORG(기본) 또는 SINGLE_ORG. 실행 중에는 바꾸지 않음
# DEPLOYMENT_MODE=MULTI_ORG
# SINGLE_ORG일 때 필수: 시작할 때 만들 조직 이름·시간대(IANA), 첫 조직 관리자 이메일
# SINGLE_ORG_NAME=
# SINGLE_ORG_TIME_ZONE=Asia/Seoul
# SINGLE_ORG_ADMIN_EMAIL=
