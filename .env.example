# .env로 복사 후 값 입력 (.env는 Git 업로드 금지)

# 필수: 로컬 PostgreSQL 비밀번호 (compose.yml과 애플리케이션 공용)
DB_PASSWORD=

# 필수: 목록 커서 서명 키 (base64, 32바이트 이상. 만들기: openssl rand -base64 32)
CURSOR_SIGNING_KEY=

# 필수: Google OAuth 클라이언트 (Google Cloud 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택: 비우면 application.yml 기본값 사용
# APP_BASE_URL=
# TERMS_VERSION=
# PRIVACY_VERSION=
# DB_URL=
# DB_USERNAME=
# APP_VERSION=
# APP_MIN_VERSION=
# SESSION_IDLE_TIMEOUT=8h
# SESSION_MAX_LIFETIME=7d
# SESSION_MAX_PER_ACCOUNT=10
# 활동 기록 보관 기간 (365d 미만이면 시작 실패)
# ACTIVITY_LOG_RETENTION=365d
# 완료된 이벤트 발행 기록 보관 기간. 기본값 30d, 1d 미만이면 시작 실패 (modules.md ARCH-EVT-08)
# EVENT_PUBLICATION_RETENTION=
# 배포 모드 MULTI_ORG 또는 SINGLE_ORG. 비우면 MULTI_ORG, 실행 중에는 바꾸지 않음
# DEPLOYMENT_MODE=
# SINGLE_ORG일 때 필수: 시작할 때 만들 조직 이름, IANA 시간대 이름(예: Asia/Seoul), 첫 조직 관리자 이메일
# SINGLE_ORG_NAME=
# SINGLE_ORG_TIME_ZONE=
# SINGLE_ORG_ADMIN_EMAIL=
# 운영자 계정 ID(account.id, UUID)를 쉼표로 나눠 적음. 비우면 운영자 없음, UUID가 아니면 시작 실패
# 운영자는 MULTI_ORG에서 조직 정지·해제만 함(security.md SEC-ORG-12)
# OPERATOR_ACCOUNT_IDS=
# 앞단 리버스 프록시가 있을 때만 native. 넣지 않으면 none(접속 IP만 믿음, X-Forwarded-For 무시)
# native이면 사설·루프백 주소에서 온 프록시 헤더만 믿음. 바꾸려면 SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES(정규식)
# 프록시는 X-Forwarded-For에 실제 접속 주소를 덧붙이거나 덮어써야 함(그대로 넘기면 IP 위조 가능, security.md SEC-RATE-12)
# FORWARD_HEADERS_STRATEGY=
# 요청 제한 한도. 기본값과 시간 창은 application.yml의 reberu.rate-limit (security.md §13.2)
# RATE_LIMIT_LOGIN=
# RATE_LIMIT_INVITE_LINK=
# RATE_LIMIT_INVITATION=
# RATE_LIMIT_JOIN_REQUEST=
# RATE_LIMIT_ORG_CREATE=
# RATE_LIMIT_PUBLIC_ORG_SEARCH=
# RATE_LIMIT_POSTING=
# RATE_LIMIT_DEFAULT=
# 초대 링크 사용이 같은 IP에서 연속으로 실패하면 15분 막는 횟수(security.md SEC-RATE-16)
# RATE_LIMIT_INVITE_LINK_FAILURES=
# 규칙·키 종류(IP, 계정)마다 기억하는 키 상한. 넘으면 그 종류의 새 키는 429
# RATE_LIMIT_MAX_KEYS_PER_RULE=
# 관리 포트(지표·상태 확인). 외부에 공개하지 않음(observability.md OPS-OBS-01). 기본값은 포트 8081, 주소 127.0.0.1
# Prometheus가 다른 호스트나 컨테이너망에서 수집하면 그 망에서만 닿는 주소로 바꿈
# 포트를 바꾸면 ops/prometheus/prometheus.yml의 수집 대상도 함께 바꿈
# MANAGEMENT_PORT=
# MANAGEMENT_ADDRESS=
# observability 프로필(Prometheus·Grafana)을 띄울 때만 필수. 빈 값과 admin이면 Grafana가 시작하지 않음
# GRAFANA_ADMIN_PASSWORD=
